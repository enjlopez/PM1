<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landscaping Services</title>
</head>
<body>
  <h1>Scheduled Landscaping Services</h1>
  <table border="1">
    <thead>
      <tr>
        <th>Service Type</th>
        <th>Date</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <% services.forEach(service => { %>
        <tr>
          <td><%= service.serviceType %></td>
          <td><%= service.date %></td>
          <td><%= service.notes %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>